# Laravel mobile API base (includes /api/v1)
# Browser / emulator with adb reverse: http://127.0.0.1:8001/api/v1
# Physical device / APK on same Wi‑Fi: http://YOUR_LAN_IP:8001/api/v1
#   (serve API with: php artisan serve --host=0.0.0.0 --port=8001)
# Production: https://your-domain/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
